# ======================
# Angular / Node Ignore
# ======================

# dependencies
node_modules/

# production build
/dist
/build

# Angular cache
.angular/

# environment files
src/environments/*.ts
!src/environments/environment.ts

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDEs & Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# testing
/coverage

# temporary files
tmp/
temp/

# dotenv
.env
.env.local
.env.*.local

# lock files (optional)
package-lock.json
yarn.lock

# system files
*.swp
*.bak

# Angular build cache
.cache/

# GitHub
.github/

# local configs
.local/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
